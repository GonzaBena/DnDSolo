---
import Base from "../layouts/Base.astro";

// Without a Google client id the build has no sync at all: none of its markup ships.
const syncBuild = Boolean(import.meta.env.PUBLIC_GOOGLE_CLIENT_ID);
---

<Base title="Bienvenida">
  <script is:inline slot="head">
    // Before first paint, so a returning player never sees the first-visit
    // landing flash. "pending" (no hint yet, e.g. the first load after an
    // update) keeps both states invisible until refresh() decides; the timeout
    // shows the landing if the page script never runs.
    (() => {
      let hint = null;
      try { hint = localStorage.getItem("dnsolo.home"); } catch {}
      const root = document.documentElement;
      if (hint === "returning") root.dataset.home = "returning";
      if (hint === null) {
        root.dataset.home = "pending";
        setTimeout(() => { if (root.dataset.home === "pending") delete root.dataset.home; }, 1500);
      }
    })();
  </script>
  <div id="home-first" class="home" data-enter-children>
    <svg class="hero" viewBox="0 0 320 180" role="img" aria-label="Un dado de veinte caras sobre un camino hacia las montañas">
      <defs>
        <clipPath id="hero-frame"><rect x="2" y="2" width="316" height="176" rx="12" /></clipPath>
      </defs>
      <g clip-path="url(#hero-frame)">
        <rect class="hero__sky" x="2" y="2" width="316" height="176" />
        <circle class="hero__sun" cx="250" cy="52" r="22" />
        <polygon class="hero__far" points="2,140 70,62 120,112 170,48 240,128 318,84 318,178 2,178" />
        <polygon class="hero__near" points="2,178 2,150 90,120 190,150 318,128 318,178" />
      </g>
      <rect class="hero__frame" x="2" y="2" width="316" height="176" rx="12" />
      <g class="hero__die">
        <polygon points="120,58 166,84 166,134 120,160 74,134 74,84" />
        <polygon class="hero__face" points="120,82 148,128 92,128" />
        <path d="M120 58L120 82M74 84L120 82L166 84M74 84L92 128L74 134M166 84L148 128L166 134M92 128L120 160L148 128" />
        <text x="120" y="121" text-anchor="middle">20</text>
      </g>
    </svg>
    <h1>Tu aventura, tu Dungeon Master</h1>
    <p class="home-lead">Jugá D&amp;D en solitario desde el navegador. Una IA narra la campaña; vos decidís qué hace tu personaje.</p>
    <a class="button button--primary home-cta" href="/character">Empezar una campaña</a>
    <p class="home-secondary">
      ¿Ya tenés una partida? <button id="import-save-first" type="button" class="link-button">Importala</button>{syncBuild ? " de un archivo o de tu Drive." : "."}
    </p>

    <section class="home-steps" aria-labelledby="how-title">
      <h2 id="how-title">Cómo funciona</h2>
      <ol>
        <li><strong>Creá tu personaje</strong><span>Elegí raza y clase, o dejá que la app lo genere por vos.</span></li>
        <li><strong>Pegá tu API key</strong><span>La narración usa tu propia clave de Gemini. <a href="/docs#api-key">Cómo conseguirla</a></span></li>
        <li><strong>Jugá</strong><span>La IA narra; los dados y las reglas los resuelve la app.</span></li>
      </ol>
      <a class="home-steps__more" href="/docs">Leer la guía completa</a>
    </section>

    <p class="home-privacy">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <span>Tus partidas se guardan en este navegador.{syncBuild && " Si querés, sincronizalas con tu Google Drive."}</span>
    </p>

    {/* Development aid: only rendered by `npm run dev`, never in a build. */}
    {import.meta.env.DEV && (
      <button id="load-mock" type="button" class="button">Cargar partida de ejemplo</button>
    )}
  </div>

  <div id="home-returning" class="home" data-enter-children>
    <h1>La aventura sigue</h1>
    <article class="continue-card" aria-labelledby="continue-name">
      <svg class="continue-card__banner" viewBox="0 0 320 90" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect class="hero__sky" x="-4" y="-4" width="328" height="98" />
        <circle class="hero__sun" cx="262" cy="30" r="15" />
        <polygon class="hero__far" points="-4,80 60,30 110,62 170,22 240,72 324,40 324,94 -4,94" />
        <polygon class="hero__near" points="-4,94 -4,84 90,68 190,86 324,72 324,94" />
      </svg>
      <div class="continue-card__body">
        <span id="continue-initials" class="continue-card__avatar" aria-hidden="true"></span>
        <h2 id="continue-name"></h2>
        <p id="continue-subtitle" class="continue-card__subtitle"></p>
        <p id="continue-excerpt" class="continue-card__excerpt" hidden></p>
        <p id="continue-detail" class="continue-card__detail"></p>
        <a id="continue-play" class="button button--primary home-cta" href="/play">Seguir jugando</a>
      </div>
    </article>

    <div class="home-pair">
      <a class="button" href="/character">Nueva campaña</a>
      <button id="import-save-returning" type="button" class="button">Importar</button>
    </div>

    <section id="others" class="others" aria-labelledby="others-title">
      <div class="others__header">
        <h2 id="others-title">Otras campañas</h2>
        <button id="open-load" type="button" class="link-button">Ver todas (<span id="others-count"></span>)</button>
      </div>
      <ul id="others-list" class="others__list"></ul>
    </section>
  </div>

  <div id="menu-load" hidden>
    <h2>Cargar campaña</h2>
    <p id="saves-empty" class="status" hidden>Todavía no hay campañas guardadas.</p>
    <ul id="saves" class="saves"></ul>
    <div class="actions">
      <button id="close-load" type="button" class="button">Volver</button>
      <button id="import-save" type="button" class="button">Importar campaña</button>
    </div>
  </div>

  <dialog id="delete-dialog" class="sync-dialog" aria-labelledby="delete-title">
    <div class="sync-dialog__panel">
      <h2 id="delete-title" class="sync-dialog__title"></h2>
      <p id="delete-detail" class="sync-dialog__footer"></p>
      <p id="delete-warning"></p>
      <p id="delete-error" class="status" data-tone="error" hidden>No se pudo borrar la campaña.</p>
      <div class="sync-dialog__row delete-dialog__actions">
        <button id="delete-cancel" type="button" class="button">Cancelar</button>
        <button id="delete-confirm" type="button" class="button button--primary">Borrar</button>
      </div>
    </div>
  </dialog>

  <dialog id="import-dialog" class="sync-dialog" aria-labelledby="import-title">
    <div class="sync-dialog__panel">
      <h2 id="import-title" class="sync-dialog__title">Importar campaña</h2>
      <button id="drop-zone" type="button" class="drop-zone">
        <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
          <path d="M12 15V3M7 8l5-5 5 5M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" />
        </svg>
        <strong id="drop-title">Seleccioná o arrastrá una campaña</strong>
        <small id="drop-hint">El archivo .json que exportaste desde DnDSolo</small>
      </button>
      <input id="import-file" type="file" accept="application/json,.json" hidden />
      <div id="import-conflict" class="import-conflict" role="group" aria-labelledby="import-conflict-text" hidden>
        <p id="import-conflict-text"></p>
        <div class="import-conflict__actions">
          <button id="import-replace" type="button" class="button button--primary">Reemplazar</button>
          <button id="import-copy" type="button" class="button">Guardar como copia</button>
        </div>
      </div>
      {syncBuild && (
        <section class="drive-import" aria-labelledby="drive-import-title">
          <h3 id="drive-import-title" class="import-divider"><span>En tu Google Drive</span></h3>
          <p id="drive-note" class="sync-dialog__footer" aria-live="polite"></p>
          <ul id="drive-list" class="drive-list" hidden></ul>
          <button id="drive-action" type="button" class="button" hidden></button>
          <a id="drive-connect" class="button" href="/settings#sync-section" hidden>Conectar Google Drive</a>
        </section>
      )}
      <div class="sync-dialog__row import-dialog__footer">
        <button id="import-close" type="button" class="button">Cerrar</button>
      </div>
    </div>
  </dialog>
  <p id="save-info" class="status" role="status" aria-live="polite"></p>
</Base>

<script>
  import type { GameState } from "../domain/types";
  import { enterPage } from "../animations/motion";
  import { downloadGame } from "../persistence/exportGame";
  import { summarizeCampaign } from "../home/campaignSummary";
  import { matchImport } from "../home/importMatch";
  import { migrateSave } from "../persistence/migrations";
  import { loadGis } from "../sync/gis";
  import { describeSummary, showSyncToast } from "../sync/firstConnect";
  import { driveRows, pendingCount, STATUS_TEXT } from "../sync/driveImport";
  import { SYNC_TAPPED_EVENT } from "../sync/indicator";
  import { syncStatus } from "../sync/status";
  import { syncBeforeOpen } from "../sync/openGame";
  import { createGameRepo, getSyncRuntime, withRenewal } from "../sync/runtime";

  // Null when sync is off: then the page works exactly as without sync.
  const sync = getSyncRuntime();
  const repo = createGameRepo();
  const homes = [...document.querySelectorAll<HTMLElement>("#home-first, #home-returning")];
  const loadPanel = document.querySelector<HTMLElement>("#menu-load")!;
  const savesList = document.querySelector<HTMLUListElement>("#saves")!;
  const info = document.querySelector<HTMLParagraphElement>("#save-info")!;
  const emptyNote = document.querySelector<HTMLElement>("#saves-empty")!;
  const importFile = document.querySelector<HTMLInputElement>("#import-file")!;
  const importDialog = document.querySelector<HTMLDialogElement>("#import-dialog")!;
  const dropZone = document.querySelector<HTMLButtonElement>("#drop-zone")!;

  function report(message: string, tone: "ok" | "error") {
    info.dataset.tone = tone;
    info.textContent = message;
  }

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const playHref = (id: string) => `/play?id=${encodeURIComponent(id)}`;

  // The pre-paint script reads this hint; the saved list is the truth.
  function setHome(state: "first" | "returning") {
    document.documentElement.dataset.home = state;
    try {
      localStorage.setItem("dnsolo.home", state);
    } catch {
      // Blocked storage: only the pre-paint guess is lost.
    }
  }

  function renderContinue(game: GameState) {
    const summary = summarizeCampaign(game);
    byId("continue-initials").textContent = summary.initials;
    byId("continue-name").textContent = summary.name;
    byId("continue-subtitle").textContent = summary.subtitle;
    const excerpt = byId("continue-excerpt");
    excerpt.textContent = summary.excerpt ? `“${summary.excerpt}”` : "";
    excerpt.hidden = !summary.excerpt;
    byId("continue-detail").textContent = summary.detail;
    byId<HTMLAnchorElement>("continue-play").href = playHref(game.id);
    byId("home-returning").dataset.ready = ""; // filled: CSS stops hiding it
  }

  // Names come from the player and the model, so they go in as text, never as HTML.
  function renderOthers(games: GameState[], total: number) {
    // "Ver todas" stays even without others: it is the way to export or delete.
    const others = byId("others");
    byId("others-title").hidden = games.length === 0;
    // The hidden title can't name the section; a label does instead.
    if (games.length) {
      others.setAttribute("aria-labelledby", "others-title");
      others.removeAttribute("aria-label");
    } else {
      others.removeAttribute("aria-labelledby");
      others.setAttribute("aria-label", "Tus campañas");
    }
    byId("others-count").textContent = String(total);
    byId("others-list").replaceChildren(
      ...games.map((game) => {
        const summary = summarizeCampaign(game);
        const item = document.createElement("li");
        item.className = "campaign-row";
        const avatar = document.createElement("span");
        avatar.className = "campaign-row__avatar";
        avatar.setAttribute("aria-hidden", "true");
        avatar.textContent = summary.initials;
        const text = document.createElement("div");
        const name = document.createElement("strong");
        name.textContent = summary.name;
        const sub = document.createElement("small");
        sub.textContent = [summary.subtitle, summary.detail.split(" · ")[0]].filter(Boolean).join(" · ");
        text.append(name, sub);
        const play = document.createElement("a");
        play.className = "button button--small";
        play.href = playHref(game.id);
        play.textContent = "Jugar";
        item.append(avatar, text, play);
        return item;
      }),
    );
  }

  // Names come from the player and the model, so they go in as text, never as HTML.
  function renderSaves(games: GameState[]) {
    savesList.replaceChildren(
      ...games.map((game) => {
        const { name, subtitle, detail } = summarizeCampaign(game);
        const item = document.createElement("li");
        item.className = "save";

        const text = document.createElement("div");
        const title = document.createElement("strong");
        title.textContent = subtitle ? `${name}, ${subtitle}` : name;
        const sub = document.createElement("small");
        sub.textContent = detail;
        text.append(title, sub);

        const play = document.createElement("a");
        play.className = "button button--primary";
        play.href = playHref(game.id);
        play.textContent = "Jugar";

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "button";
        remove.textContent = "Borrar";
        remove.addEventListener("click", () => askDelete(game));

        const exportButton = document.createElement("button");
        exportButton.type = "button";
        exportButton.className = "button";
        exportButton.textContent = "Exportar";
        exportButton.addEventListener("click", () => downloadGame(game));

        item.append(text, play, exportButton, remove);
        return item;
      }),
    );
  }

  // "Ver todas" looks like its own page, so it gets a history entry: the
  // browser's back button returns to the home instead of leaving it.
  const CAMPAIGNS_HASH = "#campanas";
  const visibleChildren = (parent: Element) => [...parent.children].filter((el) => el.getClientRects().length > 0);

  function showMain() {
    const wasOpen = !loadPanel.hidden;
    loadPanel.hidden = true;
    for (const home of homes) home.hidden = false; // CSS shows the active one
    if (wasOpen) enterPage(homes.flatMap(visibleChildren));
  }

  function showCampaigns() {
    if (!loadPanel.hidden) return;
    for (const home of homes) home.hidden = true;
    loadPanel.hidden = false;
    // The rows rise one by one, not the list as a block.
    enterPage(visibleChildren(loadPanel).flatMap((el) => (el === savesList ? [...savesList.children] : [el])));
  }

  /** Back to the home: pops our own entry, or rewrites a URL opened directly at #campanas. */
  function leaveCampaigns() {
    if ((history.state as { view?: string } | null)?.view === "campaigns") return history.back();
    history.replaceState(null, "", location.pathname + location.search);
    showMain();
  }

  window.addEventListener("popstate", () => {
    if (location.hash === CAMPAIGNS_HASH) showCampaigns();
    else showMain();
  });

  // Delete asks in a centred dialog; Cancel, Escape or the backdrop keep the campaign.
  const deleteDialog = byId<HTMLDialogElement>("delete-dialog");
  const deleteConfirm = byId<HTMLButtonElement>("delete-confirm");
  const deleteError = byId("delete-error");
  let deleting: GameState | null = null;
  function askDelete(game: GameState) {
    const { name, subtitle, detail } = summarizeCampaign(game);
    deleting = game;
    byId("delete-title").textContent = `¿Borrar «${name}»?`;
    byId("delete-detail").textContent = [subtitle, detail].filter(Boolean).join(" · ");
    byId("delete-warning").textContent = sync
      ? "Se borra en este dispositivo y en tu Google Drive."
      : "No se puede deshacer. Exportala antes si querés guardar una copia.";
    deleteError.hidden = true;
    deleteConfirm.disabled = false;
    deleteDialog.showModal();
    byId("delete-cancel").focus();
  }
  byId("delete-cancel").addEventListener("click", () => deleteDialog.close());
  deleteDialog.addEventListener("click", (event) => {
    if (event.target === deleteDialog) deleteDialog.close(); // backdrop
  });
  deleteDialog.addEventListener("close", () => (deleting = null));
  deleteConfirm.addEventListener("click", async () => {
    if (!deleting) return;
    deleteConfirm.disabled = true;
    try {
      await repo.delete(deleting.id);
      await refresh();
      deleteDialog.close();
      if (!savesList.children.length) leaveCampaigns();
    } catch {
      deleteError.hidden = false;
      deleteConfirm.disabled = false;
    }
  });

  async function refresh() {
    const games = await repo.list();
    const [latest, ...rest] = games;
    if (latest) renderContinue(latest);
    renderOthers(rest.slice(0, 2), games.length);
    setHome(latest ? "returning" : "first");
    emptyNote.hidden = games.length > 0;
    renderSaves(games);
  }

  const showRefreshError = () => {
    // Saves unreadable: show the landing rather than keep the page blank.
    if (document.documentElement.dataset.home === "pending") setHome("first");
    info.dataset.tone = "error";
    info.textContent = "No se pudo leer las partidas guardadas en este navegador.";
  };
  // Local first, so the list never waits for Drive.
  const firstPaint = refresh().catch(showRefreshError);
  // Reloading (or sharing) /#campanas opens the list again.
  if (location.hash === CAMPAIGNS_HASH) void firstPaint.then(showCampaigns);
  // Back from /play restores this page from the bfcache: the card would show
  // the campaign as it was before that session.
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) void refresh().catch(showRefreshError);
  });

  if (sync) {
    // A tap on the navbar sync button may have brought games from Drive.
    document.addEventListener(SYNC_TAPPED_EVENT, () => void refresh().catch(showRefreshError));
    // Any sync may have changed this device's games (a download, a delete the
    // player agreed to in the conflict dialog): re-read the list when one ends.
    let wasSyncing = false;
    syncStatus.subscribe(({ state }) => {
      if (wasSyncing && state !== "syncing") void refresh().catch(showRefreshError);
      wasSyncing = state === "syncing";
    });

    // Renewing opens a Google window, which needs GIS already loaded when the click lands.
    let gisReady = false;
    loadGis()
      .then(() => (gisReady = true))
      .catch(() => undefined);

    // Without a token this does nothing; the import dialog is where a tap brings Drive's campaigns.
    void firstPaint
      .then(() => sync.engine.syncAll())
      .catch(() => undefined)
      .then(() => refresh().catch(showRefreshError));

    // "Seguir jugando" and "Jugar" renew with that same tap, reconcile the game, then navigate.
    let opening = false;
    document.addEventListener("click", (event) => {
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[href^='/play']") : null;
      if (!link || link.getAttribute("aria-disabled") === "true") return;
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (!gisReady || !sync.auth.needsGesture()) return; // navigate normally
      event.preventDefault();
      if (opening) return;
      opening = true;
      const href = link.href;
      const id = new URL(href).searchParams.get("id");
      // A closed or failed Google window still opens the local copy.
      void withRenewal(sync, () => syncBeforeOpen(sync, id)).finally(() => {
        opening = false;
        location.href = href;
      });
    });
    // Back from /play restores this page from the bfcache with its old state: unlock the links.
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) opening = false;
    });
  }

  // Drive half of the import dialog. Listing needs a token: with one it loads
  // on open; without one, a tap renews (the Google window needs that tap).
  const driveNote = document.querySelector<HTMLElement>("#drive-note");
  const driveList = document.querySelector<HTMLUListElement>("#drive-list");
  const driveAction = document.querySelector<HTMLButtonElement>("#drive-action");
  const driveConnect = document.querySelector<HTMLElement>("#drive-connect");
  type DriveStep = "list" | "bring";
  let driveStep: DriveStep = "list";
  let driveBusy = false;

  function showDrive(note: string, action: string | null, step: DriveStep = "list") {
    if (!driveNote || !driveAction) return;
    driveNote.textContent = note;
    driveAction.hidden = !action;
    driveAction.textContent = action ?? "";
    driveAction.classList.toggle("button--primary", step === "bring");
    driveStep = step;
  }

  async function loadDrive() {
    if (!sync || !driveList) return;
    driveBusy = true;
    showDrive("Buscando en tu Drive…", null);
    driveList.hidden = true;
    try {
      const [remote, local] = await Promise.all([sync.listRemote(), repo.list()]);
      const rows = driveRows(remote, local);
      driveList.replaceChildren(
        ...rows.map((row) => {
          const item = document.createElement("li");
          item.className = "drive-row";
          item.dataset.status = row.status;
          const text = document.createElement("div");
          const name = document.createElement("strong");
          name.textContent = row.name;
          const date = document.createElement("small");
          date.textContent = new Date(row.updatedAt).toLocaleDateString("es-AR");
          text.append(name, date);
          const badge = document.createElement("span");
          badge.className = "drive-row__status";
          badge.textContent = STATUS_TEXT[row.status];
          item.append(text, badge);
          return item;
        }),
      );
      driveList.hidden = rows.length === 0;
      const pending = pendingCount(rows);
      if (!rows.length) showDrive("Todavía no hay campañas en tu Drive.", null);
      else if (!pending) showDrive("Tenés todo al día.", null);
      else showDrive("", pending === 1 ? "Traer 1 campaña" : `Traer ${pending} campañas`, "bring");
    } catch {
      showDrive(
        sync.auth.needsGesture() ? "Hace falta volver a dar permiso a Google Drive." : "No se pudo leer tu Drive.",
        "Reintentar",
      );
    } finally {
      driveBusy = false;
    }
  }

  function openImport() {
    if (!importDialog.open) importDialog.showModal();
    if (!driveNote) return; // build without sync
    driveConnect!.hidden = Boolean(sync);
    if (!sync) {
      driveList!.hidden = true;
      return showDrive("Conectá tu Google Drive para traer las campañas de tus otros dispositivos.", null);
    }
    if (driveBusy) return;
    if (sync.auth.needsGesture()) {
      driveList!.hidden = true;
      return showDrive("Tocá para ver las campañas que tenés guardadas en Drive.", "Ver campañas de Drive");
    }
    void loadDrive();
  }

  driveAction?.addEventListener("click", () => {
    if (!sync || driveBusy) return;
    driveAction.disabled = true;
    // withRenewal runs synchronously in the click: the Google window needs the live gesture.
    const run =
      driveStep === "bring"
        ? async () => {
            const summary = await sync.engine.syncAll();
            if (summary) showSyncToast(describeSummary(summary));
            await refresh().catch(showRefreshError);
            await loadDrive();
          }
        : loadDrive;
    void withRenewal(sync, run).finally(() => (driveAction.disabled = false));
  });

  for (const id of ["import-save", "import-save-first", "import-save-returning"]) byId(id).addEventListener("click", openImport);
  byId("import-close").addEventListener("click", () => importDialog.close());
  importDialog.addEventListener("click", (event) => {
    if (event.target === importDialog) importDialog.close(); // backdrop
  });
  // A bad file keeps the dialog open: the zone turns red with the reason for a
  // few seconds, or until the next try, so the player can pick another one.
  const dropTitle = byId("drop-title");
  const dropHint = byId("drop-hint");
  const dropDefaults = [dropTitle.textContent, dropHint.textContent];
  const DROP_ERROR_MS = 4000;
  let dropErrorTimer: ReturnType<typeof setTimeout> | undefined;
  function clearDropError() {
    clearTimeout(dropErrorTimer);
    delete dropZone.dataset.error;
    delete dropZone.dataset.notice;
    [dropTitle.textContent, dropHint.textContent] = dropDefaults;
  }
  /** "error" turns the zone red; "notice" only tells (the file was fine). */
  function showDropError(message: string, hint = "Probá con otro archivo.", tone: "error" | "notice" = "error") {
    clearDropError();
    dropZone.dataset[tone] = "";
    dropTitle.textContent = message;
    dropHint.textContent = hint;
    dropErrorTimer = setTimeout(clearDropError, DROP_ERROR_MS);
  }

  // Importing a campaign this device already has: identical saves are
  // skipped; a different version asks whether to replace it or keep both.
  const conflictBox = byId("import-conflict");
  const conflictText = byId("import-conflict-text");
  let conflictGame: GameState | null = null;
  function clearConflict() {
    conflictGame = null;
    conflictBox.hidden = true;
  }
  function askConflict(game: GameState, newer: boolean) {
    conflictGame = game;
    const { name } = summarizeCampaign(game);
    conflictText.textContent = newer
      ? `Ya tenés «${name}». La del archivo es más nueva.`
      : `Ya tenés «${name}», y la tuya es más nueva que la del archivo.`;
    conflictBox.hidden = false;
    byId(newer ? "import-replace" : "import-copy").focus();
  }
  byId("import-replace").addEventListener("click", () => {
    if (conflictGame) void saveImported(conflictGame, "Campaña importada.", true);
  });
  byId("import-copy").addEventListener("click", () => {
    if (conflictGame) void saveImported({ ...conflictGame, id: crypto.randomUUID() }, "Se guardó como una campaña aparte.");
  });
  importDialog.addEventListener("close", () => {
    clearDropError();
    clearConflict();
  });

  dropZone.addEventListener("click", () => {
    clearDropError();
    clearConflict();
    importFile.click();
  });
  dropZone.addEventListener("dragover", (event) => {
    event.preventDefault();
    clearDropError();
    clearConflict();
    dropZone.dataset.over = "";
  });
  dropZone.addEventListener("dragleave", () => delete dropZone.dataset.over);
  dropZone.addEventListener("drop", (event) => {
    event.preventDefault();
    delete dropZone.dataset.over;
    const file = event.dataTransfer?.files[0];
    if (file) void importGameFile(file);
  });
  byId("open-load").addEventListener("click", () => {
    history.pushState({ view: "campaigns" }, "", CAMPAIGNS_HASH);
    showCampaigns();
  });
  importFile.addEventListener("change", () => {
    const file = importFile.files?.[0];
    importFile.value = "";
    if (file) void importGameFile(file);
  });

  async function importGameFile(file: File) {
    clearDropError();
    clearConflict();
    let game: GameState | null;
    try {
      // Same gate as loading from disk: migrate, validate, or refuse.
      game = migrateSave(JSON.parse(await file.text()));
    } catch {
      game = null;
    }
    if (!game) return showDropError("Ese archivo no es una campaña válida.");
    let match;
    try {
      match = matchImport(game, await repo.load(game.id));
    } catch {
      return showDropError("No se pudo leer tus campañas guardadas.");
    }
    if (match === "same") return showDropError("Ya tenés esta campaña.", "No hacía falta importarla.", "notice");
    if (match === "new") return saveImported(game, "Campaña importada.", true);
    askConflict(game, match === "newer");
  }

  // Replacing keeps the id, so it overwrites (and syncs) the campaign already here.
  // `restore`: the file keeps its id, and the player wants it back even if it
  // was deleted from Drive before (otherwise sync would ask to delete it again).
  async function saveImported(game: GameState, message = "Campaña importada.", restore = false) {
    if (restore) sync?.engine.allowRestore(game.id);
    try {
      await repo.save(game);
      await refresh();
      importDialog.close();
      report(message, "ok");
      setTimeout(() => {
        if (info.textContent === message) info.textContent = "";
      }, DROP_ERROR_MS);
    } catch {
      clearConflict();
      showDropError("No se pudo guardar la campaña.");
    }
  }
  document.querySelector("#close-load")!.addEventListener("click", leaveCampaigns);

  // The dynamic import sits behind the DEV check so a production build
  // doesn't ship the sample game.
  const mockButton = document.querySelector<HTMLButtonElement>("#load-mock");
  if (import.meta.env.DEV && mockButton) {
    mockButton.addEventListener("click", async () => {
      try {
        const { loadMockGame } = await import("../persistence/mockGame");
        const game = loadMockGame();
        await repo.save(game);
        location.href = `/play?id=${encodeURIComponent(game.id)}`;
      } catch {
        info.dataset.tone = "error";
        info.textContent = "No se pudo cargar la partida de ejemplo.";
      }
    });
  }
</script>
