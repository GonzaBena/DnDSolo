---
import Base from "../layouts/Base.astro";

// Without a Google client id the build has no sync at all: none of its markup ships.
const syncBuild = Boolean(import.meta.env.PUBLIC_GOOGLE_CLIENT_ID);
---

<Base title="Bienvenida">
  {syncBuild && (
    <>
      <div id="sync-gesture" class="notice" hidden>
        <button id="sync-gesture-button" type="button" class="button">Tocá para traer tus partidas de Drive</button>
      </div>
    </>
  )}

  <div id="home-first" class="home">
    <svg class="hero" viewBox="0 0 320 180" role="img" aria-label="Un dado de veinte caras sobre un camino hacia las montañas">
      <defs>
        <clipPath id="hero-frame"><rect x="2" y="2" width="316" height="176" rx="12" /></clipPath>
      </defs>
      <g clip-path="url(#hero-frame)">
        <rect class="hero__sky" x="2" y="2" width="316" height="176" />
        <circle class="hero__sun" cx="250" cy="52" r="22" />
        <polygon class="hero__far" points="2,140 70,62 120,112 170,48 240,128 318,84 318,178 2,178" />
        <polygon class="hero__near" points="2,178 2,150 90,120 190,150 318,128 318,178" />
      </g>
      <rect class="hero__frame" x="2" y="2" width="316" height="176" rx="12" />
      <g class="hero__die">
        <polygon points="120,58 166,84 166,134 120,160 74,134 74,84" />
        <polygon class="hero__face" points="120,82 148,128 92,128" />
        <path d="M120 58L120 82M74 84L120 82L166 84M74 84L92 128L74 134M166 84L148 128L166 134M92 128L120 160L148 128" />
        <text x="120" y="121" text-anchor="middle">20</text>
      </g>
    </svg>
    <h1>Tu aventura, tu Dungeon Master</h1>
    <p class="home-lead">Jugá D&amp;D en solitario desde el navegador. Una IA narra la campaña; vos decidís qué hace tu personaje.</p>
    <a class="button button--primary home-cta" href="/character">Empezar una campaña</a>
    <p class="home-secondary">
      ¿Ya tenés una partida? <button id="import-save-first" type="button" class="link-button">Importala</button>{syncBuild && (<> o <a href="/settings#sync-section">traela de Drive</a></>)}
    </p>

    <section class="home-steps" aria-labelledby="how-title">
      <h2 id="how-title">Cómo funciona</h2>
      <ol>
        <li><strong>Creá tu personaje</strong><span>Elegí raza y clase, o dejá que la app lo genere por vos.</span></li>
        <li><strong>Pegá tu API key</strong><span>La narración usa tu propia clave de Gemini. <a href="/docs#api-key">Cómo conseguirla</a></span></li>
        <li><strong>Jugá</strong><span>La IA narra; los dados y las reglas los resuelve la app.</span></li>
      </ol>
      <a class="home-steps__more" href="/docs">Leer la guía completa</a>
    </section>

    <p class="home-privacy">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <span>Tus partidas se guardan en este navegador.{syncBuild && " Si querés, sincronizalas con tu Google Drive."}</span>
    </p>

    {/* Development aid: only rendered by `npm run dev`, never in a build. */}
    {import.meta.env.DEV && (
      <button id="load-mock" type="button" class="button">Cargar partida de ejemplo</button>
    )}
  </div>

  <div id="menu-load" hidden>
    <h2>Cargar campaña</h2>
    <p id="saves-empty" class="status" hidden>Todavía no hay campañas guardadas.</p>
    <ul id="saves" class="saves"></ul>
    <div class="actions">
      <button id="close-load" type="button" class="button">Volver</button>
      <button id="import-save" type="button" class="button">Importar campaña</button>
      <input id="import-file" type="file" accept="application/json,.json" hidden />
    </div>
  </div>
  <p id="save-info" class="status" role="status" aria-live="polite"></p>
</Base>

<script>
  import type { GameState } from "../domain/types";
  import { downloadGame } from "../persistence/exportGame";
  import { migrateSave } from "../persistence/migrations";
  import { loadGis } from "../sync/gis";
  import { SYNC_TAPPED_EVENT } from "../sync/indicator";
  import { syncBeforeOpen } from "../sync/openGame";
  import { createGameRepo, getSyncRuntime, withRenewal } from "../sync/runtime";

  // Null when sync is off: then the page works exactly as without sync.
  const sync = getSyncRuntime();
  const repo = createGameRepo();
  const main = document.querySelector<HTMLElement>("#home-first")!;
  const loadPanel = document.querySelector<HTMLElement>("#menu-load")!;
  const savesList = document.querySelector<HTMLUListElement>("#saves")!;
  const info = document.querySelector<HTMLParagraphElement>("#save-info")!;
  const emptyNote = document.querySelector<HTMLElement>("#saves-empty")!;
  const importButton = document.querySelector<HTMLButtonElement>("#import-save")!;
  const importFile = document.querySelector<HTMLInputElement>("#import-file")!;

  function report(message: string, tone: "ok" | "error") {
    info.dataset.tone = tone;
    info.textContent = message;
  }

  const describe = (game: GameState) => {
    const player = game.players[0];
    const who = player ? `${player.name}, ${player.characterClass} nivel ${player.level}` : "Sin personaje";
    const turns = game.turns.length === 1 ? "1 turno" : `${game.turns.length} turnos`;
    return { who, detail: `${turns} · ${new Date(game.updatedAt).toLocaleDateString("es-AR")}` };
  };

  // Names come from the player and the model, so they go in as text, never as HTML.
  function renderSaves(games: GameState[]) {
    savesList.replaceChildren(
      ...games.map((game) => {
        const { who, detail } = describe(game);
        const item = document.createElement("li");
        item.className = "save";

        const text = document.createElement("div");
        const title = document.createElement("strong");
        title.textContent = who;
        const sub = document.createElement("small");
        sub.textContent = detail;
        text.append(title, sub);

        const play = document.createElement("a");
        play.className = "button button--primary";
        play.href = `/play?id=${encodeURIComponent(game.id)}`;
        play.textContent = "Jugar";

        // Two clicks to delete: the first arms the button, no browser dialog.
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "button";
        remove.textContent = "Borrar";
        remove.addEventListener("click", async () => {
          if (remove.dataset.armed !== "true") {
            remove.dataset.armed = "true";
            remove.textContent = sync ? "¿Seguro? Se borra en todos tus dispositivos" : "¿Seguro?";
            return;
          }
          try {
            await repo.delete(game.id);
            await refresh();
            if (!savesList.children.length) showMain();
          } catch {
            info.dataset.tone = "error";
            info.textContent = "No se pudo borrar la campaña.";
          }
        });

        const exportButton = document.createElement("button");
        exportButton.type = "button";
        exportButton.className = "button";
        exportButton.textContent = "Exportar";
        exportButton.addEventListener("click", () => downloadGame(game));

        item.append(text, play, exportButton, remove);
        return item;
      }),
    );
  }

  function showMain() {
    loadPanel.hidden = true;
    main.hidden = false;
  }

  async function refresh() {
    const games = await repo.list();
    emptyNote.hidden = games.length > 0;
    renderSaves(games);
  }

  const showRefreshError = () => {
    info.dataset.tone = "error";
    info.textContent = "No se pudo leer las partidas guardadas en este navegador.";
  };
  // Local first, so the list never waits for Drive.
  const firstPaint = refresh().catch(showRefreshError);

  if (sync) {
    // A tap on the navbar sync button may have brought games from Drive.
    document.addEventListener(SYNC_TAPPED_EVENT, () => {
      updateGesture();
      void refresh().catch(showRefreshError);
    });
    const gesture = document.querySelector<HTMLElement>("#sync-gesture");
    const gestureButton = document.querySelector<HTMLButtonElement>("#sync-gesture-button");

    // Renewing opens a Google window, which needs GIS already loaded when the click lands.
    let gisReady = false;
    const updateGesture = () => {
      if (gesture) gesture.hidden = !(gisReady && sync.auth.needsGesture());
    };
    loadGis()
      .then(() => {
        gisReady = true;
        updateGesture();
      })
      .catch(() => undefined);

    void firstPaint
      .then(() => sync.engine.syncAll())
      .catch(() => undefined)
      .then(() => {
        updateGesture(); // auto-renewal learns only now whether the server lost the grant
        return refresh().catch(showRefreshError);
      });

    gestureButton?.addEventListener("click", () => {
      // Synchronous inside the click, before any await: browsers block the popup otherwise.
      void withRenewal(sync, () => sync.engine.syncAll()).then(() => {
        updateGesture();
        return refresh().catch(showRefreshError);
      });
    });

    // "Continuar" and "Jugar" renew with that same tap, reconcile the game, then navigate.
    let opening = false;
    document.addEventListener("click", (event) => {
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[href^='/play']") : null;
      if (!link || link.getAttribute("aria-disabled") === "true") return;
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (!gisReady || !sync.auth.needsGesture()) return; // navigate normally
      event.preventDefault();
      if (opening) return;
      opening = true;
      const href = link.href;
      const id = new URL(href).searchParams.get("id");
      // A closed or failed Google window still opens the local copy.
      void withRenewal(sync, () => syncBeforeOpen(sync, id)).finally(() => {
        opening = false;
        location.href = href;
      });
    });
    // Back from /play restores this page from the bfcache with its old state: unlock the links.
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted) return;
      opening = false;
      updateGesture();
    });
  }

  importButton.addEventListener("click", () => importFile.click());
  document.querySelector("#import-save-first")!.addEventListener("click", () => importFile.click());
  importFile.addEventListener("change", async () => {
    const file = importFile.files?.[0];
    importFile.value = "";
    if (!file) return;
    try {
      // Same gate as loading from disk: migrate, validate, or refuse.
      const game = migrateSave(JSON.parse(await file.text()));
      if (!game) return report("Ese archivo no es una campaña válida de esta versión.", "error");
      // Never overwrite a campaign that already has this id.
      const imported = (await repo.load(game.id)) ? { ...game, id: crypto.randomUUID() } : game;
      await repo.save(imported);
      await refresh();
      report("Campaña importada.", "ok");
    } catch {
      report("No se pudo importar el archivo.", "error");
    }
  });
  document.querySelector("#close-load")!.addEventListener("click", showMain);

  // The dynamic import sits behind the DEV check so a production build
  // doesn't ship the sample game.
  const mockButton = document.querySelector<HTMLButtonElement>("#load-mock");
  if (import.meta.env.DEV && mockButton) {
    mockButton.addEventListener("click", async () => {
      try {
        const { loadMockGame } = await import("../persistence/mockGame");
        const game = loadMockGame();
        await repo.save(game);
        location.href = `/play?id=${encodeURIComponent(game.id)}`;
      } catch {
        info.dataset.tone = "error";
        info.textContent = "No se pudo cargar la partida de ejemplo.";
      }
    });
  }
</script>
