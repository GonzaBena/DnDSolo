---
import Base from "../layouts/Base.astro";
import "../styles/settings.css";

// Without a Google client id the build has no sync at all: the section is not rendered.
const syncBuild = Boolean(import.meta.env.PUBLIC_GOOGLE_CLIENT_ID);

// The HTML `switch` attribute (Safari draws a native switch) is newer than the typings.
const switchAttr: Record<string, string> = { switch: "" };
---

<Base title="Configuración">
  <h1>Configuración</h1>
  <p id="missing-notice" class="notice" hidden>
    Para jugar necesitás cargar tu API key de Gemini y elegir un modelo.
  </p>

  <form id="settings-form" class="settings" novalidate>
    <section class="settings-section" aria-labelledby="ai-title">
      <header class="settings-section__header">
        <h2 id="ai-title">Inteligencia artificial</h2>
        <p>El DM usa Gemini con tu propia API key.</p>
      </header>

      <div class="settings-field">
        <label for="api-key">API key de Gemini</label>
        <div class="settings-inline">
          <input
            id="api-key"
            name="api-key"
            type="password"
            autocomplete="off"
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            aria-describedby="api-key-help"
            required
          />
          <button id="toggle-key" type="button" class="button button--small" aria-pressed="false" aria-controls="api-key">
            Mostrar
          </button>
        </div>
        <small id="api-key-help">
          Se guarda solo en este navegador. Podés crear una en{" "}
          <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">Google AI Studio</a>.
        </small>
      </div>

      <div class="settings-field">
        <label for="model">Modelo</label>
        <div class="settings-inline">
          <select id="model" name="model" required disabled aria-describedby="model-help">
            <option value="">Cargá tu key para ver los modelos</option>
          </select>
          <button id="load-models" type="button" class="button button--small">Cargar modelos</button>
        </div>
        <small id="model-help">La lista depende de tu key: recargala si cambiás de key.</small>
      </div>
    </section>

    <fieldset class="settings-section">
      <legend class="settings-section__legend">Narración</legend>
      <p class="settings-section__lead">Cómo se comporta el DM durante la partida.</p>

      <label class="switch-row">
        <span class="switch-row__text">
          <strong>Respuestas rápidas</strong>
          <small>El DM piensa menos y contesta antes.</small>
        </span>
        <input id="fast-narration" name="fast-narration" type="checkbox" class="switch" {...switchAttr} role="switch" />
      </label>

      <label class="switch-row">
        <span class="switch-row__text">
          <strong>Sugerencias de acción</strong>
          <small>El DM propone hasta tres ideas después de cada respuesta.</small>
        </span>
        <input id="show-suggestions" name="show-suggestions" type="checkbox" class="switch" {...switchAttr} role="switch" checked />
      </label>
    </fieldset>

    <div class="settings-footer">
      <p id="status" class="status" role="status" aria-live="polite"></p>
      <div class="settings-footer__buttons">
        <button id="test" type="button" class="button">Probar conexión</button>
        <button type="submit" class="button button--primary">Guardar cambios</button>
      </div>
    </div>
  </form>

  {syncBuild && (
    <section id="sync-section" class="settings-section settings-section--divided" aria-labelledby="sync-title">
      <header class="settings-section__header">
        <h2 id="sync-title">Sincronización entre dispositivos</h2>
      </header>
      <div id="sync-off" class="settings-row">
        <p class="settings-row__text">Guardá tus campañas en tu Google Drive para seguirlas en otro dispositivo.</p>
        <button id="sync-connect" type="button" class="button button--primary" aria-disabled="true">Conectar Google Drive</button>
      </div>
      <div id="sync-on" class="settings-stack" hidden>
        <div class="settings-row">
          <p id="sync-line" class="sync-indicator settings-row__text" data-state="idle"></p>
          <div class="settings-row__buttons">
            <button id="sync-now" type="button" class="button button--small">Sincronizar ahora</button>
            <button id="sync-disconnect" type="button" class="button button--small">Desconectar</button>
          </div>
        </div>
        <label class="switch-row">
          <span class="switch-row__text">
            <strong>Renovar la conexión automáticamente</strong>
            <small>Usa el servidor de DnSolo para no pedirte que vuelvas a entrar. Tus partidas siguen solo en tu Drive.</small>
          </span>
          <input id="sync-auto-renew" type="checkbox" class="switch" {...switchAttr} role="switch" disabled />
        </label>
      </div>
      <p id="sync-status" class="status" role="status" aria-live="polite"></p>
    </section>
  )}

  <nav class="settings-section settings-section--divided" aria-label="Volver">
    <a class="button" href="/">Volver al inicio</a>
  </nav>
</Base>

<script>
  import { GeminiClient, listGeminiModels } from "../llm/GeminiClient";
  import { describeLLMError } from "../llm/errorMessages";
  import { loadSettings, saveSettings } from "../persistence/settings";
  import { loadSyncConfig, saveSyncConfig } from "../sync/config";
  import { clearDismissedConflicts } from "../sync/conflictDialog";
  import type { DriveAuth } from "../sync/DriveAuth";
  import { loadGis } from "../sync/gis";
  import { createDriveAuth, disconnectSync, getSyncRuntime, startSyncRuntime, withRenewal } from "../sync/runtime";
  import { connectFailureMessage, describeConnection } from "../sync/settingsCopy";
  import { syncStatus } from "../sync/status";

  const form = document.querySelector<HTMLFormElement>("#settings-form")!;
  const keyInput = document.querySelector<HTMLInputElement>("#api-key")!;
  const modelSelect = document.querySelector<HTMLSelectElement>("#model")!;
  const fastInput = document.querySelector<HTMLInputElement>("#fast-narration")!;
  const suggestionsInput = document.querySelector<HTMLInputElement>("#show-suggestions")!;
  const loadButton = document.querySelector<HTMLButtonElement>("#load-models")!;
  const testButton = document.querySelector<HTMLButtonElement>("#test")!;
  const status = document.querySelector<HTMLParagraphElement>("#status")!;
  const notice = document.querySelector<HTMLParagraphElement>("#missing-notice")!;

  const toggleKeyButton = document.querySelector<HTMLButtonElement>("#toggle-key")!;

  function setStatus(text: string, tone: "info" | "ok" | "error" = "info") {
    status.textContent = text;
    status.dataset.tone = tone;
  }

  /** Marks the empty required fields and focuses the first one; true when nothing is missing. */
  function requireFilled(fields: (HTMLInputElement | HTMLSelectElement)[]): boolean {
    const missing = fields.filter((field) => !field.value.trim());
    for (const field of fields) {
      if (missing.includes(field)) field.setAttribute("aria-invalid", "true");
      else field.removeAttribute("aria-invalid");
    }
    // A model list that was never loaded can't take focus: its "Cargar modelos" button can.
    const first = missing[0];
    if (first) (first.disabled ? loadButton : first).focus();
    return missing.length === 0;
  }

  for (const field of [keyInput, modelSelect]) {
    const clear = () => field.value.trim() && field.removeAttribute("aria-invalid");
    field.addEventListener("input", clear);
    field.addEventListener("change", clear);
  }

  toggleKeyButton.addEventListener("click", () => {
    const show = keyInput.type === "password";
    keyInput.type = show ? "text" : "password";
    toggleKeyButton.setAttribute("aria-pressed", String(show));
    toggleKeyButton.textContent = show ? "Ocultar" : "Mostrar";
  });

  async function loadModels(preferred: string) {
    const apiKey = keyInput.value.trim();
    if (!requireFilled([keyInput])) {
      setStatus("Primero pegá tu API key.", "error");
      return;
    }
    setStatus("Cargando modelos…");
    loadButton.disabled = true;
    try {
      const models = await listGeminiModels(apiKey);
      modelSelect.replaceChildren(
        new Option("Elegí un modelo", ""),
        ...models.map((m) => new Option(m.label, m.id)),
      );
      modelSelect.disabled = false;
      // Keep the saved choice only if this key can still use it.
      if (models.some((m) => m.id === preferred)) modelSelect.value = preferred;
      setStatus(`${models.length} modelos disponibles.`, "ok");
    } catch (error) {
      setStatus(describeLLMError(error), "error");
    } finally {
      loadButton.disabled = false;
    }
  }

  loadButton.addEventListener("click", () => void loadModels(modelSelect.value));

  testButton.addEventListener("click", async () => {
    const apiKey = keyInput.value.trim();
    const model = modelSelect.value;
    if (!requireFilled([keyInput, modelSelect])) {
      setStatus("Necesitás una API key y un modelo para probar.", "error");
      return;
    }
    setStatus("Probando…");
    testButton.disabled = true;
    try {
      const reply = await new GeminiClient(apiKey, model).generateText({
        prompt: "Saludá en una sola oración corta, como un Dungeon Master que da la bienvenida.",
      });
      setStatus(`Funciona. El modelo respondió: «${reply.trim()}»`, "ok");
    } catch (error) {
      setStatus(describeLLMError(error), "error");
    } finally {
      testButton.disabled = false;
    }
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const apiKey = keyInput.value.trim();
    const model = modelSelect.value;
    if (!requireFilled([keyInput, modelSelect])) {
      setStatus("Necesitás una API key y un modelo para guardar.", "error");
      return;
    }
    saveSettings({
      apiKey,
      model,
      fastNarration: fastInput.checked,
      showSuggestions: suggestionsInput.checked,
    });
    notice.hidden = true;
    setStatus("Configuración guardada.", "ok");
  });

  const saved = loadSettings();
  notice.hidden = !new URLSearchParams(location.search).has("missing");
  if (saved) {
    keyInput.value = saved.apiKey;
    fastInput.checked = saved.fastNarration;
    suggestionsInput.checked = saved.showSuggestions;
    void loadModels(saved.model);
  }

  // Sync section: only in builds with a Google client id (the markup is absent otherwise).
  const syncSection = document.querySelector<HTMLElement>("#sync-section");
  if (syncSection) setUpSync(syncSection);

  function setUpSync(section: HTMLElement) {
    const offView = section.querySelector<HTMLElement>("#sync-off")!;
    const onView = section.querySelector<HTMLElement>("#sync-on")!;
    const line = section.querySelector<HTMLElement>("#sync-line")!;
    const connectButton = section.querySelector<HTMLButtonElement>("#sync-connect")!;
    const autoRenewInput = section.querySelector<HTMLInputElement>("#sync-auto-renew")!;
    const syncNowButton = section.querySelector<HTMLButtonElement>("#sync-now")!;
    const disconnectButton = section.querySelector<HTMLButtonElement>("#sync-disconnect")!;
    const syncMessage = section.querySelector<HTMLParagraphElement>("#sync-status")!;

    const say = (text: string, tone: "info" | "ok" | "error" = "info") => {
      syncMessage.textContent = text;
      syncMessage.dataset.tone = tone;
    };

    // Connecting opens a Google window, which must open inside the click: GIS has to be loaded by then.
    let gisReady = false;
    let gisLoading = false;
    let busy = false;

    const renderLine = (status = syncStatus.get()) => {
      // Nothing synced on this page yet and the browser token is gone: the line suggests a tap.
      const needsGesture = getSyncRuntime()?.auth.needsGesture() ?? false;
      line.dataset.state = status.state === "off" ? "idle" : status.state;
      line.textContent = describeConnection(status, Date.now(), needsGesture);
    };

    const render = () => {
      const sync = getSyncRuntime();
      offView.hidden = sync !== null;
      onView.hidden = sync === null;
      // aria-disabled (not disabled) while GIS loads: it stays focusable, so focusing it starts the load.
      if (gisReady) connectButton.removeAttribute("aria-disabled");
      else connectButton.setAttribute("aria-disabled", "true");
      connectButton.disabled = busy;
      autoRenewInput.disabled = !gisReady || busy;
      syncNowButton.disabled = !gisReady || busy;
      disconnectButton.disabled = busy;
      autoRenewInput.checked = loadSyncConfig().autoRenew;
      renderLine();
    };

    syncStatus.subscribe((status) => renderLine(status));
    // Keeps "hace N min" honest while the page stays open.
    setInterval(() => renderLine(), 30_000);

    // GIS loads only for someone about to use this section (or who already synced), never for every visitor.
    const LOADING = "Cargando Google…";
    const ensureGis = () => {
      if (gisReady || gisLoading) return;
      gisLoading = true;
      say(LOADING);
      loadGis()
        .then(() => {
          gisReady = true;
          if (syncMessage.textContent === LOADING) say("");
        })
        .catch(() => say("No se pudo cargar el inicio de sesión de Google. Revisá tu conexión y probá de nuevo.", "error"))
        .finally(() => {
          gisLoading = false;
          render();
        });
    };
    for (const type of ["pointerenter", "focusin", "touchstart"]) {
      section.addEventListener(type, ensureGis, { passive: true });
    }
    if (getSyncRuntime()) ensureGis();

    /** Runs `connect` (already called inside the click) and, on success, makes `auth` the page's runtime. */
    const finishConnect = async (auth: DriveAuth, connecting: Promise<boolean>, autoRenew: boolean) => {
      let failure: unknown = false;
      try {
        if (await connecting) {
          saveSyncConfig({ enabled: true, autoRenew });
          const sync = startSyncRuntime(auth);
          say("Conectado a Google Drive.", "ok");
          void sync.engine.syncAll();
          return true;
        }
      } catch (error) {
        failure = error;
      }
      say(connectFailureMessage(failure), "error");
      return false;
    };

    connectButton.addEventListener("click", () => {
      if (!gisReady) return ensureGis();
      if (busy) return;
      const auth = createDriveAuth(false);
      const connecting = auth.connect(); // synchronous inside the click: popups need the live gesture
      busy = true;
      render();
      say("Esperando a Google…");
      void finishConnect(auth, connecting, false).finally(() => {
        busy = false;
        render();
      });
    });

    // Switching changes the kind of permission, so it asks Google again. Both modes share one
    // grant, so nothing is revoked at Google here: revoking either side would end the new one too.
    autoRenewInput.addEventListener("change", () => {
      const current = getSyncRuntime();
      const autoRenew = autoRenewInput.checked;
      if (!current || !gisReady || busy) return render();
      const auth = createDriveAuth(autoRenew);
      const connecting = auth.connect(); // the click's only gesture call, before any await
      busy = true;
      render();
      say("Esperando a Google…");
      void finishConnect(auth, connecting, autoRenew)
        .then((ok) => {
          // Success: the old mode lets go of its credentials only (browser token, or the server's cookie).
          // Failure: the old mode was never touched and keeps working.
          if (ok) void current.auth.forget();
        })
        .finally(() => {
          busy = false;
          render();
        });
    });

    syncNowButton.addEventListener("click", () => {
      const sync = getSyncRuntime();
      if (!sync) return;
      // An explicit action: conflicts dismissed earlier are asked again.
      clearDismissedConflicts();
      say("");
      void withRenewal(sync, () => sync.engine.syncAll());
    });

    disconnectButton.addEventListener("click", () => {
      const sync = getSyncRuntime();
      if (!sync || busy) return;
      busy = true;
      render();
      void disconnectSync(sync).finally(() => {
        busy = false;
        render();
        say("Desconectado. Tus campañas siguen en este dispositivo y en tu Drive.", "ok");
      });
    });

    render();
    // A fresh status for the line; with an expired browser token it waits for "Sincronizar ahora".
    const sync = getSyncRuntime();
    if (sync && !sync.auth.needsGesture()) void sync.engine.syncAll();
  }
</script>
