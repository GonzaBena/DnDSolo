---
import "../styles/global.css";
import "../sync/sync.css";

interface Props {
  title: string;
  footer?: boolean;
  /** Game screen: no generator link, and a header that hides while scrolling down. */
  game?: boolean;
}

const { title, footer = true, game = false } = Astro.props;
const syncBuild = Boolean(import.meta.env.PUBLIC_GOOGLE_CLIENT_ID);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="DnDSolo" />
    <meta name="theme-color" content="#f4e7cf" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1512" media="(prefers-color-scheme: dark)" />
    <title>{title} · DnDSolo</title>
    <script is:inline>
      // Theme is resolved before first paint so the page never flashes the
      // wrong palette: the saved choice wins, otherwise the system setting.
      (() => {
        let theme = null;
        try { theme = localStorage.getItem("dnsolo.theme"); } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();

      // Runs before first paint: hides the page's blocks only when they are
      // about to be animated in, so there's no flash of final content. The
      // timeout is a safety net in case the animation script never loads.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("entering");
        setTimeout(() => document.documentElement.classList.remove("entering"), 1500);
      }
    </script>
  </head>
  <body class:list={{ "game-shell": game }}>
    <header class="site-header">
      <a class="brand" href="/">
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
          <polygon class="brand__die" points="16,2 29,9.5 29,22.5 16,30 3,22.5 3,9.5" />
          <path class="brand__lines" d="M3 9.5L16 14L29 9.5M16 14L16 30" />
        </svg>
        DnDSolo
      </a>
      <nav class="site-nav">
        {!game && (
          <a class="icon-button" href="/generator" aria-label="Generador de personajes" title="Generador de personajes">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M19 8v6M22 11h-6" />
            </svg>
          </a>
        )}
        {syncBuild && (
          <button id="sync-nav" class="icon-button sync-nav" type="button" hidden>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M7 18a4.5 4.5 0 0 1-.6-8.96A6 6 0 0 1 17.8 8.5 4.75 4.75 0 0 1 17.5 18Z" />
              <path class="sync-nav__arrows" d="M9.5 12.5a2.75 2.75 0 0 1 4.9-1.2M14.5 13.5a2.75 2.75 0 0 1-4.9 1.2M14.6 9.8v1.6H13M9.4 16.2v-1.6H11" />
            </svg>
          </button>
        )}
        <a class="icon-button" href="/settings" aria-label="Configuración" title="Configuración">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
          </svg>
        </a>
        <button class="theme-toggle" type="button" aria-label="Cambiar a modo oscuro">
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
          </svg>
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" />
            <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
          </svg>
        </button>
      </nav>
    </header>
    <main class="page">
      <slot />
    </main>
    {footer && (
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} DnDSolo. Todos los derechos reservados.</p>
        <p class="attribution">
          Incluye material del SRD 5.2.1 de Wizards of the Coast LLC, bajo licencia CC-BY-4.0.{" "}
          <a href="/credits">Ver créditos</a>
        </p>
      </footer>
    )}
    <script>
      import { enterPage } from "../animations/motion";

      // Sync button: the module loads only in builds that have it.
      const syncNav = document.querySelector<HTMLButtonElement>("#sync-nav");
      if (syncNav) void import("../sync/indicator").then(({ mountSyncIndicator }) => mountSyncIndicator(syncNav));

      const blocks = [...document.querySelectorAll(".page > *")];
      enterPage(blocks);
      document.documentElement.classList.remove("entering");

      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const labelToggle = () => {
        toggle?.setAttribute(
          "aria-label",
          root.dataset.theme === "dark" ? "Cambiar a modo claro" : "Cambiar a modo oscuro",
        );
      };
      labelToggle();
      toggle?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("dnsolo.theme", next);
        } catch {
          // Blocked storage: the choice still applies to this page.
        }
        labelToggle();
      });

      // Game screen: the header slides away while reading down and comes
      // back as soon as the player scrolls up, so home is always one flick
      // away without stealing space from the story.
      const header = document.querySelector<HTMLElement>(".site-header");
      if (document.body.classList.contains("game-shell") && header) {
        const body = document.body;
        const measure = () => body.style.setProperty("--header-h", `${header.offsetHeight}px`);
        measure();
        new ResizeObserver(measure).observe(header);

        let lastY = window.scrollY;
        let ticking = false;
        const MIN_DELTA = 8;
        const update = () => {
          ticking = false;
          // Clamp to the real scroll range: Safari's rubber-band bounce
          // past the bottom (and top) briefly reports out-of-range values,
          // and the spring back would otherwise read as scrolling up.
          const maxY = document.documentElement.scrollHeight - window.innerHeight;
          const y = Math.min(Math.max(window.scrollY, 0), Math.max(maxY, 0));
          const delta = y - lastY;
          if (y <= header.offsetHeight) {
            body.dataset.header = "shown";
          } else if (Math.abs(delta) >= MIN_DELTA) {
            body.dataset.header = delta > 0 ? "hidden" : "shown";
          } else {
            return;
          }
          lastY = y;
        };
        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
          },
          { passive: true },
        );
        // Keyboard users tabbing into the nav must be able to see it.
        header.addEventListener("focusin", () => (body.dataset.header = "shown"));
      }
    </script>
  </body>
</html>
